{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "mcpServers": {
    "inkscape-mcp": {
      "command": "uv",
      "args": [
        "--directory",
        "${workspaceFolder}",
        "run",
        "inkscape-mcp",
        "--mode",
        "stdio"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "description": "Inkscape SVG, vector and live document workflows over MCP. FastMCP 3.4+, stdio and HTTP transports.",
      "capabilities": {
        "tools": {
          "enabled": true,
          "listChanged": true
        },
        "resources": {
          "enabled": true,
          "listChanged": true,
          "subscribe": true
        },
        "prompts": {
          "enabled": true
        }
      },
      "timeout": {
        "initialize": 30000,
        "message": 120000
      },
      "metadata": {
        "version": "2.6.0",
        "author": "Sandra Schipal",
        "homepage": "https://github.com/GianluDeveloper/inkscape-mcp",
        "license": "MIT",
        "tags": [
          "inkscape",
          "svg",
          "vector-graphics",
          "mcp",
          "fastmcp",
          "automation",
          "design",
          "creative-tools"
        ],
        "categories": [
          "Design",
          "Productivity",
          "Creative",
          "Development"
        ]
      }
    }
  },
  "maintainers": [
    "GianluDeveloper"
  ],
  "name": "inkscape-mcp",
  "description": "Inkscape SVG, vector and live document workflows over MCP. FastMCP 3.4+, stdio and HTTP transports.",
  "type": "mcp_server",
  "status": "beta",
  "framework": "FastMCP 3.4+",
  "tools": 16,
  "transport": [
    "stdio",
    "http"
  ],
  "keywords": [
    "inkscape",
    "svg",
    "vector",
    "mcp-server",
    "fastmcp",
    "graphics",
    "automation"
  ],
  "features": {
    "vector_editing": {
      "enabled": true,
      "capabilities": [
        "boolean_ops",
        "path_ops",
        "trace",
        "barcode_qr",
        "export_convert"
      ]
    },
    "document_analysis": {
      "enabled": true,
      "capabilities": [
        "statistics",
        "validate",
        "dimensions",
        "structure"
      ]
    },
    "agentic_sampling": {
      "enabled": true,
      "capabilities": [
        "sep_1577",
        "generate_svg",
        "workflow_orchestration"
      ]
    },
    "mcpb_packaging": {
      "enabled": true
    },
    "rest_bridge": {
      "enabled": true,
      "capabilities": [
        "health",
        "help",
        "logs",
        "generate_svg_ollama"
      ]
    }
  }
}
