<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>MCP: Append SVG</name>
  <id>org.inkscape.inkscape-mcp.edit-xml</id>
  <effect>
    <object-type>all</object-type>
    <effects-menu hidden="true"/>
  </effect>
  <script>
    <command location="inx" interpreter="python">mcp_edit_xml.py</command>
  </script>
</inkscape-extension>
