{
  "manifest_version": "0.2",
  "name": "inkscape-mcp",
  "version": "2.6.0",
  "description": "Inkscape SVG, vector and live document workflows over MCP (FastMCP 3.4+)",
  "author": {
    "name": "Sandra Schipal"
  },
  "server": {
    "type": "python",
    "entry_point": "run_server.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--no-dev",
        "--directory",
        "${__dirname}",
        "run_server.py",
        "--mode",
        "stdio"
      ],
      "env": {
        "PYTHONPATH": "${__dirname}/src",
        "PYTHONUNBUFFERED": "1",
        "MCP_TRANSPORT": "stdio"
      }
    }
  },
  "tools": [
    {
      "name": "inkscape_file",
      "description": "File validation, metadata, saving, format conversion"
    },
    {
      "name": "inkscape_vector",
      "description": "SVG construction, path editing, queries, previews"
    },
    {
      "name": "inkscape_analysis",
      "description": "Document statistics and structural inspection"
    },
    {
      "name": "inkscape_render",
      "description": "PNG previews and multi-DPI exports"
    },
    {
      "name": "inkscape_validation",
      "description": "SVG quality and size checks"
    },
    {
      "name": "inkscape_system",
      "description": "Runtime status, installed actions, live desktop operations"
    },
    {
      "name": "inkscape_fleet",
      "description": "Handoffs to other graphics applications"
    },
    {
      "name": "inkscape_fab_art",
      "description": "Fabrication and robotics asset workflows"
    },
    {
      "name": "inkscape_sim_art",
      "description": "Icon packs, sheets, simulation/VR asset staging"
    },
    {
      "name": "list_local_models",
      "description": "Local model discovery"
    },
    {
      "name": "llm_ops",
      "description": "Local model engine management"
    },
    {
      "name": "generate_heraldry",
      "description": "Preset heraldic SVG"
    },
    {
      "name": "generate_svg",
      "description": "SVG generation using client sampling"
    },
    {
      "name": "agentic_inkscape_workflow",
      "description": "Sampling-assisted workflow planning"
    },
    {
      "name": "intelligent_vector_processing",
      "description": "Sampling-assisted processing plans"
    },
    {
      "name": "conversational_inkscape_assistant",
      "description": "Sampling-assisted vector graphics guidance"
    }
  ],
  "homepage": "https://github.com/GianluDeveloper/inkscape-mcp",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GianluDeveloper/inkscape-mcp"
  },
  "compatibility": {
    "runtimes": {
      "python": ">=3.12"
    }
  }
}
