# Example exported settings for the main Inkscape MCP entry point.
# The CLI does not automatically load this file. Copy values into your MCP
# client's env block or export them in the shell before starting the server.
# On Linux, a trusted local copy can be loaded with: set -a; . ./.env; set +a
# Do not commit a populated .env containing provider keys.

# stdio is the default; use http for a listener.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=11027
# Dashboard backend explicitly uses 11028; the Bun/Vite frontend uses 11029.

# Optional executable override when discovery does not find the desired binary.
# INKSCAPE_PATH=/usr/bin/inkscape
# Windows classic desktop installer (not Microsoft Store):
# INKSCAPE_PATH="C:\Program Files\Inkscape\bin\inkscape.exe"

# Optional GUI mode hint; this does not grant desktop/session access.
# INKSCAPE_GUI_WATCH=1
# Preserve the desktop's DISPLAY/WAYLAND_DISPLAY, DBUS_SESSION_BUS_ADDRESS,
# XDG_RUNTIME_DIR and XAUTHORITY where applicable. Do not invent their values.
# Native live edits require install_live_extension and a restart of old windows.

# Optional logging and metrics.
# INKSCAPE_MCP_LOG_FORMAT=json
# INKSCAPE_MCP_METRICS_ENABLED=false
# PROMETHEUS_PORT=9074

# Optional dashboard generation providers; ordinary MCP edits need none of these.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5-coder:latest
# INKSCAPE_SAVE_DIR=/absolute/path/to/generated
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Inkscape profile override: install the extension into the same profile used
# by target GUI instances. Leave unset for the normal desktop profile.
# INKSCAPE_PROFILE_DIR=/absolute/path/to/inkscape-profile
